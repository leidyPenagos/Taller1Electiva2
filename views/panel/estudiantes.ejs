<!DOCTYPE html>
<html lang="es">
<head>
<%- include('../partials/head') %>
</head>
<body class="bg-light d-flex flex-column min-vh-100">

<script src="/js/api.js"></script>

<%- include('../partials/navbar') %>
<%- include('../partials/header') %>

<main class="container flex-grow-1">

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Listado de estudiantes</h4>
    <button class="btn btn-primary" id="btnNuevoEstudiante">
      Nuevo estudiante
    </button>
  </div>

  <div class="card shadow-sm">
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Nombre</th><th>Documento</th><th>Correo</th><th>Edad</th><th>Programa</th><th>Maestro</th><th class="text-end">Acciones</th>
          </tr>
        </thead>
        <tbody id="estudiantesBody"></tbody>
      </table>
    </div>
    <div class="text-center text-muted py-5" id="estudiantesEmpty" style="display:none;">
      Todavía no hay estudiantes registrados.
    </div>
  </div>

</main>

<!-- Modal: crear/editar estudiante -->
<div class="modal fade" id="modalEstudiante" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form id="formEstudiante">
        <div class="modal-header">
          <h5 class="modal-title" id="modalEstudianteTitle">Nuevo estudiante</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="alert alert-danger py-2" id="formEstudianteError" style="display:none;"></div>
          <input type="hidden" id="estudianteId">
          <div class="mb-3">
            <label class="form-label">Nombre</label>
            <input type="text" class="form-control" id="estudianteNombre" required>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Documento</label>
              <input type="text" class="form-control" id="estudianteDocumento" required>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Edad</label>
              <input type="number" min="5" max="100" class="form-control" id="estudianteEdad" required>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Correo</label>
            <input type="email" class="form-control" id="estudianteCorreo" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Programa</label>
            <input type="text" class="form-control" id="estudiantePrograma" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Maestro a cargo</label>
            <select class="form-select" id="estudianteMaestro" required>
              <option value="">Selecciona un maestro…</option>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary">Guardar</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/toast-confirm') %>
<%- include('../partials/footer') %>
<%- include('../partials/scripts-bootstrap') %>
<script src="/js/estudiantes.js"></script>
</body>
</html>
